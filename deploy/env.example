# Copy to /opt/xiaohuang-classroom/secrets/.env (mode 600). Never commit real values.

# PostgreSQL
POSTGRES_USER=xiaohuang_cloud
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=xiaohuang_classroom

# Cloud Server
DATABASE_URL=postgresql://xiaohuang_cloud:CHANGE_ME@postgres:5432/xiaohuang_classroom
CLOUD_TOKEN_SIGNING_KEY=CHANGE_ME_32_CHARS_MINIMUM
CLOUD_AI_KEK=CHANGE_ME_32_CHARS_MINIMUM_HEX
# Production origin must be https://your-domain once TLS exists.
# IP+HTTP (http://x.x.x.x) is test-only — no real passwords, keys, or rosters.
CLOUD_PUBLIC_ORIGIN=https://your-domain.com
CLOUD_REGISTRATION_MODE=closed
CLOUD_BODY_LIMIT_BYTES=2097152
CLOUD_TRUST_PROXY=1
NODE_ENV=production

# Immutable image tags (required by compose.prod.yml). Never use latest.
# GIT_SHA=abc123
# CLOUD_IMAGE_TAG=abc123
# LAB_IMAGE_TAG=abc123
# BUILD_TIME=2026-08-12T00:00:00Z
# APP_VERSION=0.0.1
# SOURCE_REPO=https://github.com/xingyingyuzhui/Xiao-Huang-s-Classroom

# Optional backup offsite directory (30-day copy). Do not store AI KEK here.
# BACKUP_OFFSITE_DIR=/mnt/offsite/xiaohuang-backups
# RETAIN_DAYS=14
