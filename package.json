{
  "name": "xiaohuang-classroom",
  "private": true,
  "version": "0.0.1",
  "description": "小黄的教室",
  "author": "小黄的教室",
  "main": "apps/desktop/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 'test/**/*.cjs'",
    "dev": "npm run dev -w @xiaohuang/web",
    "dev:server": "npm run dev -w @xiaohuang/server",
    "dev:all": "npm run dev:server & npm run dev",
    "build": "turbo run build",
    "preview": "npm run preview -w @xiaohuang/web",
    "build:frontend": "npm run build:frontend -w @xiaohuang/server",
    "build:exe": "npm run build:exe -w @xiaohuang/server",
    "sync:offline-bank": "node scripts/sync-offline-quiz-bank.mjs",
    "sync:labs-seed": "node scripts/sync-labs-seed.mjs",
    "electron:dev": "npm run build:frontend && electron apps/desktop",
    "electron:dev:skip-build": "electron apps/desktop",
    "stage:electron": "node scripts/stage-electron-server.js",
    "pack:electron": "npm run build:frontend && npm run stage:electron && electron-builder --dir -c.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build:frontend && npm run stage:electron && electron-builder --win nsis --x64",
    "dist:mac": "npm run build:frontend && npm run stage:electron && electron-builder --mac dmg --arm64 -c.electronDist=node_modules/electron/dist",
    "dist:electron": "npm run build:frontend && npm run stage:electron && electron-builder -c.electronDist=node_modules/electron/dist",
    "typecheck": "turbo run typecheck",
    "lint": "eslint \"scripts/**/*.mjs\" \"packages/**/*.{js,ts,mjs,cjs}\" \"test/shared/*.cjs\" \"tooling/**/*.mjs\"",
    "lint:all": "eslint .",
    "lint:baseline": "node scripts/lint-baseline.mjs",
    "format": "prettier --write \".prettierrc.json\" \"tsconfig*.json\" \"tooling/**/*.json\" \"docs/engineering/**/*.md\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \".prettierrc.json\" \"tsconfig*.json\" \"tooling/**/*.json\" \"docs/engineering/**/*.md\" \"scripts/*.mjs\"",
    "quality": "npm run format:check && npm run lint && npm run lint:css && npm run lint:baseline && npm run typecheck && npm run lint:arch && npm run lint:theme-tokens && npm run lint:assets && npm test && npx turbo run test && npm run build && npm run budget && git diff --check",
    "lint:css": "stylelint \"apps/web/src/shared/styles/**/*.css\" \"packages/**/*.css\"",
    "lint:css:all": "stylelint \"apps/web/src/shared/styles/**/*.css\"",
    "lint:arch": "node tooling/architecture/check-dependencies.mjs",
    "pkg:smoke": "node scripts/pkg-smoke.mjs",
    "lint:theme-tokens": "node tooling/architecture/check-theme-tokens.mjs",
    "lint:assets": "node tooling/architecture/check-assets.mjs",
    "budget": "node tooling/performance/budget.mjs",
    "test:vitest": "turbo run test",
    "coverage": "turbo run coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "packageManager": "npm@10.8.2"
}
