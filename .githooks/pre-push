#!/bin/sh
# pre-push hook — 小黄的教室 Track E（门禁防绕过，风险计划 §7 E2-a）。
#
# 行为：本次 push 会更新远端 refs/heads/main 时，先跑 `npm run quality:fast`；
#       失败则阻止推送（exit 1 并输出原因）。非 main 推送直接放行，不跑门禁。
#
# 启用（仓库级配置，在 .git/config，不入库；每个 clone/worktree 执行一次）：
#   git config core.hooksPath .githooks
# 文档：docs/engineering/quality-commands.md 第 7 节

set -u

# 在仓库（或 worktree）根执行，保证 npm 能找到根 package.json 与 node_modules
root="$(git rev-parse --show-toplevel 2>/dev/null)" || root=""
if [ -n "$root" ]; then
  cd "$root" || exit 1
fi

# 读取 push 的 ref 更新：每行 <local ref> <local oid> <remote ref> <remote oid>
guard_main=false
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    guard_main=true
  fi
done

if [ "$guard_main" = true ]; then
  echo "pre-push: 本次推送更新 origin/main — 先跑 npm run quality:fast（失败将阻止推送）..."
  if npm run quality:fast; then
    echo "pre-push: npm run quality:fast 通过，允许推送。"
    exit 0
  fi
  echo "pre-push: npm run quality:fast 失败 — 已阻止推送到 main，请修复后重试。" >&2
  echo "pre-push: 豁免仅限负责人确认并记录原因（git push --no-verify）。" >&2
  exit 1
fi

exit 0
