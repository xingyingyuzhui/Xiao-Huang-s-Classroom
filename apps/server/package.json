{
  "name": "@xiaohuang/server",
  "version": "0.0.1",
  "description": "小黄的教室后端",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:frontend": "turbo run build --filter=@xiaohuang/web... && node scripts/copy-frontend.js",
    "build:exe": "npm run build:frontend && node scripts/pkg-win.js",
    "pkg:win": "pkg . --targets node18-win-x64 --output ../dist-exe/XiaoHuang-ChemLab.exe",
    "test:vitest": "vitest run",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "node ../../scripts/typecheck-apps.mjs server"
  },
  "dependencies": {
    "@xiaohuang/domain-core": "*",
    "@xiaohuang/math-expr": "0.0.1",
    "@xiaohuang/subject-settings": "*",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "src/routes/**/*.js",
      "src/services/**/*.js",
      "src/utils/**/*.js",
      "src/db/**/*.js",
      "src/seed/**/*.js",
      "src/paths.js"
    ],
    "assets": [
      "src/db/init.sql",
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../dist-exe"
  }
}
